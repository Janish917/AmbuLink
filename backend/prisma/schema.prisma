generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                   String             @id @default(uuid())
  email                String?            @unique
  passwordHash         String
  name                 String
  role                 String             @default("DRIVER")
  driverId             String?            @unique
  hospitalId           String?            @unique
  policeId             String?            @unique
  location             String?
  lat                  Float?
  lng                  Float?
  nodeType             String?
  status               String             @default("NORMAL")
  isVerified           Boolean            @default(false)
  otpCode              String?
  otpExpiry            DateTime?
  lastLogin            DateTime?
  registeredHospitalId String?
  verificationStatus   String             @default("pending")
  approvedBy           String?
  approvedAt           DateTime?
  phone                String?
  ambulanceNumber      String?
  employmentStatus     String             @default("active")
  shiftType            String?            @default("MORNING")
  shiftStart           String?            @default("06:00")
  shiftEnd             String?            @default("14:00")
  joinedAt             DateTime           @default(now())
  resignedAt           DateTime?
  emergencyCount       Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  activityLogs         ActivityLog[]
  alerts               Alert[]
  sessions             EmergencySession[] @relation("DriverSessions")
}

model EmergencySession {
  id                   String    @id @default(uuid())
  driverId             String
  status               String    @default("ACTIVE")
  severity             Int       @default(1)
  startLat             Float
  startLng             Float
  endLat               Float
  endLng               Float
  currentLat           Float?
  currentLng           Float?
  routePolyline        String?
  routePoints          String?
  etaExpected          Int?
  etaBest              Int?
  etaWorst             Int?
  etaConfidence        Float?
  expectedTimeSavedMin Float?
  expectedTimeSavedMax Float?
  eceiScore            Float?
  startTime            DateTime?
  endTime              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // --- ADAPTIVE CORRIDOR FIELDS ---
  emergencyMode           String   @default("STANDARD") // "URBAN_CRITICAL", "STANDARD", "TRAUMA_HIGHWAY", "ADAPTIVE_AI", "MANUAL"
  corridorRadius          Float    @default(1500.0) // in meters
  adaptiveReason          String?
  publicAlertRadius       Float    @default(500.0) // in meters
  policeAlertRadius       Float    @default(2000.0) // in meters
  signalAlertRadius       Float    @default(1200.0) // in meters
  corridorEfficiencyScore Float?

  alerts               Alert[]
  driver               User      @relation("DriverSessions", fields: [driverId], references: [id])

  // --- PREDICTIVE REROUTING FIELDS ---
  routeStability          Float?            @default(90.0)
  rerouteProbability      Float?            @default(10.0)
  congestionRisk          String?           @default("LOW")
  originalRoutePolyline   String?
  backupRoutePolyline     String?
  fastestRoutePolyline    String?
  reroutesCount           Int               @default(0)
  trafficHeatmapData      String?           // JSON string of heatmap coordinates and weights
  estimatedDelayIncrease  Int?              @default(0)
  emergencyPressureScore  Float?            @default(20.0)

  telemetryLogs           TelemetryLog[]
  rerouteHistory          RerouteHistory[]
  eventLogs               EmergencyEventLog[]
  obstructionReports      ObstructionReport[]
  stabilityHistory        CorridorStabilityHistory[]
  congestionSnapshots     CongestionSnapshot[]
  pressureLogs            EmergencyPressureLog[]
  rerouteTriggers         RerouteTrigger[]
  policeInterventions     PoliceIntervention[]
  simulationRunId         String?
  simulationRun           SimulationRun?    @relation(fields: [simulationRunId], references: [id])
  fleetRunId              String?
  fleetRun                FleetCoordinationRun? @relation(fields: [fleetRunId], references: [id])
}

model Alert {
  id                    String           @id @default(uuid())
  sessionId             String
  receiverId            String
  status                String           @default("CREATED")
  message               String
  etaToNode             Int?
  distanceToNode        Float?
  createdAt             DateTime         @default(now())
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
  bottleneckProbability Float?
  expectedResponseMax   Int?
  expectedResponseMin   Int?
  responseConfidence    Float?
  receiver              User             @relation(fields: [receiverId], references: [id])
  session               EmergencySession @relation(fields: [sessionId], references: [id])
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model TelemetryLog {
  id               String           @id @default(uuid())
  sessionId        String
  lat              Float
  lng              Float
  speed            Float
  heading          Float
  congestionLevel  Float
  timestamp        DateTime         @default(now())
  session          EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model RerouteHistory {
  id               String           @id @default(uuid())
  sessionId        String
  reason           String
  oldRoutePoints   String
  newRoutePoints   String
  oldEta           Int
  newEta           Int
  timestamp        DateTime         @default(now())
  session          EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model EmergencyEventLog {
  id               String           @id @default(uuid())
  sessionId        String
  eventType        String
  description      String
  timestamp        DateTime         @default(now())
  session          EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ObstructionReport {
  id        String   @id @default(uuid())
  sessionId String
  type      String   // "ACCIDENT", "PROTEST", "CONSTRUCTION", "FLOOD", "ROADBLOCK", "VIP_CONVOY"
  lat       Float
  lng       Float
  details   String?
  createdAt DateTime @default(now())
  session   EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CorridorStabilityHistory {
  id                 String           @id @default(uuid())
  sessionId          String
  stabilityScore     Float
  congestionRisk     String
  signalGridStatus   String
  rerouteProbability Float
  timestamp          DateTime         @default(now())
  session            EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CongestionSnapshot {
  id        String           @id @default(uuid())
  sessionId String
  density   Float
  riskLevel String
  timestamp DateTime         @default(now())
  session   EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model EmergencyPressureLog {
  id            String           @id @default(uuid())
  sessionId     String
  pressureScore Float
  timestamp     DateTime         @default(now())
  session       EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model RerouteTrigger {
  id          String           @id @default(uuid())
  sessionId   String
  triggerType String           // "AUTO", "MANUAL"
  reason      String
  oldRoute    String?
  newRoute    String?
  timestamp   DateTime         @default(now())
  session     EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model PoliceIntervention {
  id             String           @id @default(uuid())
  sessionId      String
  actionType     String           // "OVERRIDE_PRIORITY", "FORCE_PREEMPTION", "INCREASE_RADIUS", "ACTIVATE_ALTERNATE"
  details        String?
  timestamp      DateTime         @default(now())
  session        EmergencySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SimulationRun {
  id                  String             @id @default(uuid())
  scenarioName        String
  intensity           Int
  ambulanceCount      Int
  aiAggression        String
  speed               Float
  status              String             @default("RUNNING") // "RUNNING", "COMPLETED"
  efficiencyScore     Float?
  averageDelay        Float?
  rerouteCount        Int?
  stabilityMetric     Float?
  policeEffectiveness Float?
  recoveryDuration    Int?
  createdAt           DateTime           @default(now())
  sessions            EmergencySession[]
  snapshots           SimulationSnapshot[]
}

model SimulationSnapshot {
  id              String         @id @default(uuid())
  simulationRunId String
  tick            Int
  timestamp       DateTime       @default(now())
  heatmapData     String         // JSON string of sector densities
  blockages       String         // JSON string of active road blockages
  events          String         // JSON string of event messages
  ambulancePos    String         // JSON string of ambulance locations/ETAs
  simulationRun   SimulationRun  @relation(fields: [simulationRunId], references: [id], onDelete: Cascade)
}

model FleetCoordinationRun {
  id                  String             @id @default(uuid())
  status              String             @default("ACTIVE") // "ACTIVE", "COMPLETED"
  ambulanceCount      Int
  corridorUtilization Float
  conflictCount       Int
  signalOverridesCount Int
  rerouteCount        Int                @default(0)
  averageDelay        Float
  efficiencyScore     Float
  createdAt           DateTime           @default(now())
  sessions            EmergencySession[]
  logs                FleetCoordinationLog[]
}

model FleetCoordinationLog {
  id          String               @id @default(uuid())
  runId       String
  tick        Int
  timestamp   DateTime             @default(now())
  logType     String               // "CONFLICT_DETECTED", "REROUTE_ASSIGNED", "SIGNAL_PREEMPTED"
  message     String
  run         FleetCoordinationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ComplianceRun {
  id                    String              @id @default(uuid())
  status                String              @default("ACTIVE") // "ACTIVE", "COMPLETED"
  cityComplianceIndex   Float
  cooperationIndex      Float
  delayProbability      Float
  mobilityRating        Float
  createdAt             DateTime            @default(now())
  snapshots             ComplianceSnapshot[]
}

model ComplianceSnapshot {
  id              String         @id @default(uuid())
  runId           String
  tick            Int
  timestamp       DateTime       @default(now())
  sectorData      String         // JSON string of sector compliance ratings
  recommendations String         // JSON string of police suggestions
  alerts          String         // JSON string of event messages
  run             ComplianceRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Hospital {
  id                  String             @id @default(uuid())
  name                String
  lat                 Float
  lng                 Float
  icuBedsTotal        Int
  icuBedsOccupied     Int
  traumaBedsTotal     Int
  traumaBedsOccupied  Int
  erQueueLoad         Int
  doctorsAvailable    Int
  doctorsTotal        Int
  surgeryQueueLoad    Int
  status              String             @default("NORMAL") // "NORMAL", "HIGH_PRESSURE", "OVERLOADED"
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model HospitalAllocationRun {
  id                    String                         @id @default(uuid())
  status                String                         @default("ACTIVE") // "ACTIVE", "COMPLETED"
  efficiencyScore       Float
  averageIntakeTimeSec  Int
  redirectsCount        Int                            @default(0)
  createdAt             DateTime                       @default(now())
  snapshots             HospitalAllocationSnapshot[]
}

model HospitalAllocationSnapshot {
  id              String                @id @default(uuid())
  runId           String
  tick            Int
  timestamp       DateTime              @default(now())
  hospitalData    String                // JSON string of hospital loads and metrics
  activeAllocations String              // JSON string of ambulance -> hospital allocations
  recommendations String                // JSON string of AI suggestions
  alerts          String                // JSON string of event messages
  run             HospitalAllocationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}
