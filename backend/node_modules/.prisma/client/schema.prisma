generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  passwordHash String
  name         String
  role         String    @default("DRIVER") // "DRIVER", "HOSPITAL", "POLICE", "SYSTEM_NODE"
  driverId     String?   @unique
  hospitalId   String?   @unique
  policeId     String?   @unique
  location     String?
  lat          Float?
  lng          Float?
  nodeType     String? // 'POLICE_STATION', 'TRAFFIC_SIGNAL', 'HOSPITAL'
  status       String    @default("NORMAL")
  isVerified   Boolean   @default(false)
  otpCode      String?
  otpExpiry    DateTime?
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions EmergencySession[] @relation("DriverSessions")
  alerts   Alert[]
}

model EmergencySession {
  id                   String    @id @default(uuid())
  driverId             String
  driver               User      @relation("DriverSessions", fields: [driverId], references: [id])
  status               String    @default("ACTIVE") // "CREATED", "ACTIVE", "COMPLETED", "CANCELLED"
  severity             Int       @default(1) // 1 to 5
  startLat             Float
  startLng             Float
  endLat               Float
  endLng               Float
  currentLat           Float?
  currentLng           Float?
  routePolyline        String? // Encoded polyline from Maps API
  routePoints          String? // Detailed timeline prediction points JSON
  // --- V3 PROBABILISTIC FIELDS ---
  etaExpected          Int?
  etaBest              Int?
  etaWorst             Int?
  etaConfidence        Float?
  expectedTimeSavedMin Float?
  expectedTimeSavedMax Float?
  eceiScore            Float? // Emergency Corridor Efficiency Index (0-100)
  // -------------------------------
  startTime            DateTime?
  endTime              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  alerts Alert[]
}

model Alert {
  id                    String           @id @default(uuid())
  sessionId             String
  session               EmergencySession @relation(fields: [sessionId], references: [id])
  receiverId            String
  receiver              User             @relation(fields: [receiverId], references: [id])
  status                String           @default("CREATED") // "CREATED", "SENT", "ACKNOWLEDGED", "RESOLVED"
  message               String
  etaToNode             Int? // Base ETA
  distanceToNode        Float? // Meters
  // --- V3 PROBABILISTIC FIELDS ---
  expectedResponseMin   Int? // seconds
  expectedResponseMax   Int? // seconds
  responseConfidence    Float?
  bottleneckProbability Float? // 0.0 to 1.0 chance of traffic failure at this node
  // -------------------------------
  createdAt             DateTime         @default(now())
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
}
